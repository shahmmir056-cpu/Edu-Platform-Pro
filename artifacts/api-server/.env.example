# Required
DATABASE_URL=postgresql://user:pass@host:5432/db
PORT=8080
NODE_ENV=production
PUBLIC_DIR=../../ai-study-hub/dist/public

# AI API Keys (at least one required)
GROQ_API_KEY=gsk_your_key_here
GEMINI_API_KEY=your_gemini_key_here

# Kokoro TTS (self-hosted)
KOKORO_TTS_URL=http://kokoro-tts:8080

# Real WhatsApp sending (Meta WhatsApp Cloud API)
# Token from https://developers.facebook.com/apps/<app>/whatsapp-business/wa-dev-console
WHATSAPP_TOKEN=your_long_lived_whatsapp_token
# Numeric Phone Number ID shown in the WhatsApp Cloud API dashboard
WHATSAPP_PHONE_ID=your_phone_number_id

# Real email sending (Resend API) — used by StudyOS reminders and the daily report
# Key from https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here
# Sender address. Defaults to Resend's test sender onboarding@resend.dev, which can
# only deliver to your own email until you verify a custom domain.
EMAIL_FROM=onboarding@resend.dev
